    <mxCell id="74" value="&lt;b&gt;Producer: POST /deals/:id/confirm-payment&lt;/b&gt;&lt;br/&gt;requireAuth + requireCompany&lt;br/&gt;Body: { payment_reference (required), payment_proof_url (optional) }&lt;br/&gt;→ 422 if payment_reference missing&lt;br/&gt;Sets: payment_confirmed_at, payment_confirmed_by&lt;br/&gt;→ notifyDealStageChange (buyer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="670" y="1045" width="420" height="100" as="geometry"/>
    </mxCell>

    <!-- Deal state: PAYMENT_CONFIRMED -->
    <mxCell id="75" value="&lt;b&gt;STATUS: payment_confirmed&lt;/b&gt;&lt;br/&gt;SLA: 8 days from payment_confirmed_at" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="670" y="1163" width="220" height="65" as="geometry"/>
    </mxCell>

    <mxCell id="76" value="&lt;b&gt;Producer: POST /deals/:id/confirm-dispatch&lt;/b&gt;&lt;br/&gt;requireAuth + requireCompany&lt;br/&gt;Sets: dispatched_at, dispatched_by&lt;br/&gt;→ notifyDealStageChange (buyer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="670" y="1248" width="420" height="80" as="geometry"/>
    </mxCell>

    <!-- Deal state: DISPATCHED -->
    <mxCell id="77" value="&lt;b&gt;STATUS: dispatched&lt;/b&gt;&lt;br/&gt;SLA: 72 hours from dispatched_at" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="670" y="1348" width="220" height="65" as="geometry"/>
    </mxCell>

    <mxCell id="78" value="&lt;b&gt;BUYER: POST /deals/:id/confirm-receipt&lt;/b&gt;&lt;br/&gt;requireAuth + requireCompany&lt;br/&gt;Actor: buyer_company only (enforced in handler)&lt;br/&gt;Sets: received_at, received_by&lt;br/&gt;Audit: deal.receipt_confirmed (severity: info)&lt;br/&gt;→ notifyDealStageChange (producer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="670" y="1433" width="420" height="105" as="geometry"/>
    </mxCell>

    <!-- Deal state: COMPLETED -->
    <mxCell id="79" value="&lt;b&gt;STATUS: completed&lt;/b&gt;&lt;br/&gt;TERMINAL — irreversible&lt;br/&gt;received_at recorded" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="670" y="1555" width="220" height="80" as="geometry"/>
    </mxCell>

    <!-- Deal state: EXPIRED -->
    <mxCell id="80" value="&lt;b&gt;STATUS: expired&lt;/b&gt;&lt;br/&gt;TERMINAL — set by expiry job&lt;br/&gt;Audit: deal.expired (severity: warn)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="920" y="1555" width="220" height="80" as="geometry"/>
    </mxCell>

    <mxCell id="81" value="GET /deals/:id&lt;br/&gt;requireAuth + requireCompany&lt;br/&gt;Accessible by both deal parties&lt;br/&gt;Returns: deal + listing + offer data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="1480" y="885" width="280" height="75" as="geometry"/>
    </mxCell>

    <mxCell id="82" value="Deal event notifications (fire-and-forget):&lt;br/&gt;notifyDealStageChange(buyer) ← payment_confirmed&lt;br/&gt;notifyDealStageChange(buyer) ← dispatched&lt;br/&gt;notifyDealStageChange(producer) ← receipt confirmed&lt;br/&gt;notifyDealStageChange(producer+buyer) ← deal expired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
