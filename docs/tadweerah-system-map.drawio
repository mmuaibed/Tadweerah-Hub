    <mxCell id="71" value="&lt;b&gt;Deal Created&lt;/b&gt;&lt;br/&gt;on POST /offers/:id/accept" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="670" y="880" width="185" height="55" as="geometry"/>
    </mxCell>

    <!-- deals table -->
    <mxCell id="72" value="&lt;b&gt;deals&lt;/b&gt;&lt;br/&gt;──────────────────────────────&lt;br/&gt;id (uuid PK)&lt;br/&gt;offer_id (UNIQUE FK → listing_offers)&lt;br/&gt;listing_id (FK → waste_listings)&lt;br/&gt;producer_company_id (FK → companies)&lt;br/&gt;buyer_company_id (FK → companies)&lt;br/&gt;settlement_type (deal_settlement_type enum)&lt;br/&gt;price_per_unit (numeric)&lt;br/&gt;estimated_amount (numeric)&lt;br/&gt;actual_quantity (numeric)&lt;br/&gt;final_amount (numeric)&lt;br/&gt;status: active | payment_confirmed | dispatched | completed | expired&lt;br/&gt;payment_confirmed_at (timestamp)&lt;br/&gt;payment_confirmed_by (FK → companies)&lt;br/&gt;payment_reference (text) ← required at confirmation&lt;br/&gt;payment_proof_url (text) ← optional&lt;br/&gt;dispatched_at (timestamp)&lt;br/&gt;dispatched_by (FK → companies)&lt;br/&gt;received_at (timestamp) ← completion timestamp (not completed_at)&lt;br/&gt;received_by (FK → companies)&lt;br/&gt;created_at, updated_at&lt;br/&gt;&lt;br/&gt;⚠ G-04: accepted_below_highest field absent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="1115" y="875" width="350" height="420" as="geometry"/>
    </mxCell>

    <!-- Deal state: ACTIVE -->
    <mxCell id="73" value="&lt;b&gt;STATUS: active&lt;/b&gt;&lt;br/&gt;SLA: 31 days from created_at&lt;br/&gt;Contact info unlocked (producer ↔ buyer)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="670" y="950" width="220" height="75" as="geometry"/>
