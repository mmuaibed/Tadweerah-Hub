    <mxCell id="61" value="&lt;b&gt;Eligibility Gates — POST /listings/:id/offers&lt;/b&gt;&lt;br/&gt;───────────────────────────────────────────────────────&lt;br/&gt;① requireAuth + requireCompany() → 403 if no company&lt;br/&gt;② Listing must be open (status=open, closed_at=null) → 409 ListingClosed&lt;br/&gt;③ Not own listing (buyer_company_id ≠ listing.company_id) → 403 Forbidden&lt;br/&gt;④ accepted_terms_at NOT NULL → 403 TermsRequired&lt;br/&gt;⑤ license_status = approved → 403 LicenseRequired&lt;br/&gt;⑥ Targeting gate (open | category | specific_company) → 403 NotTargeted&lt;br/&gt;⑦ No existing offer (UNIQUE constraint) → 409 AlreadyBid" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="670" y="546" width="430" height="185" as="geometry"/>
    </mxCell>

    <mxCell id="62" value="&lt;b&gt;listing_offers&lt;/b&gt;&lt;br/&gt;─────────────────────────&lt;br/&gt;id (uuid PK)&lt;br/&gt;waste_listing_id (FK, cascade)&lt;br/&gt;buyer_company_id (FK, cascade)&lt;br/&gt;price_per_unit (numeric, not null)&lt;br/&gt;message (text)&lt;br/&gt;status: pending | accepted | rejected | withdrawn&lt;br/&gt;rejection_reason (text)&lt;br/&gt;acceptance_reason (text)&lt;br/&gt;created_at, updated_at, resolved_at&lt;br/&gt;UNIQUE (waste_listing_id, buyer_company_id)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="1115" y="540" width="310" height="225" as="geometry"/>
    </mxCell>

    <mxCell id="63" value="&lt;b&gt;Offer State Machine&lt;/b&gt;&lt;br/&gt;────────────────────────────────────────────────────&lt;br/&gt;[pending]&lt;br/&gt;  → BUYER: POST /offers/:id/improve&lt;br/&gt;     price_per_unit updated (must be higher)&lt;br/&gt;     Self-bid guard: requires explicit_self_improve=true → 409 if missing&lt;br/&gt;     → notifyOutbid (to previously top buyer)&lt;br/&gt;  → BUYER: POST /offers/:id/withdraw → [withdrawn]&lt;br/&gt;  → PRODUCER: POST /offers/:id/reject → [rejected]&lt;br/&gt;     rejection_reason stored&lt;br/&gt;     → notifyOfferRejected (to buyer)&lt;br/&gt;  → PRODUCER: POST /offers/:id/accept → [accepted]&lt;br/&gt;     acceptance_reason stored&lt;br/&gt;     All other pending offers auto-rejected&lt;br/&gt;     Listing closed (closed_at = now)&lt;br/&gt;     → notifyOfferAccepted (to buyer)&lt;br/&gt;     → CREATE deal row" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="1440" y="536" width="460" height="300" as="geometry"/>
    </mxCell>

    <mxCell id="64" value="GET /offers/mine&lt;br/&gt;(Buyer — participations view)&lt;br/&gt;Returns all offers by this company" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="670" y="745" width="430" height="55" as="geometry"/>
    </mxCell>

    <mxCell id="65" value="GET /listings/:id/offers&lt;br/&gt;(Producer — all offers on own listing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="1115" y="780" width="310" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="66" value="Offer event notifications (fire-and-forget):&lt;br/&gt;notifyOfferReceived → producer&lt;br/&gt;notifyOutbid → previously top buyer&lt;br/&gt;notifyOfferAccepted → buyer&lt;br/&gt;notifyOfferRejected → buyer&lt;br/&gt;notifyPrivateDealInvitation → targeted buyer (on private listing create)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="1440" y="850" width="460" height="115" as="geometry"/>
    </mxCell>

    <!-- ─── DEAL LIFECYCLE ─── -->
    <mxCell id="70" value="&lt;b&gt;DEAL LIFECYCLE — WF-09, WF-10, WF-11, WF-12&lt;/b&gt;" style="text;html=1;strokeColor=#999999;fillColor=#e0e0e0;align=center;fontStyle=1;fontSize=10;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="660" y="840" width="1390" height="28" as="geometry"/>
