    <mxCell id="92" value="&lt;b&gt;expireStaleDeals()&lt;/b&gt;&lt;br/&gt;File: jobs/expire-deals.ts&lt;br/&gt;────────────────────────────────────────&lt;br/&gt;Schedule: setInterval every 1 hour&lt;br/&gt;Also runs immediately on server startup&lt;br/&gt;────────────────────────────────────────&lt;br/&gt;SLA thresholds:&lt;br/&gt;  active → created_at older than 31 days&lt;br/&gt;  payment_confirmed → payment_confirmed_at older than 8 days&lt;br/&gt;  dispatched → dispatched_at older than 72 hours&lt;br/&gt;────────────────────────────────────────&lt;br/&gt;For each expired deal:&lt;br/&gt;  UPDATE deals SET status = 'expired', updated_at = now&lt;br/&gt;  logAudit(deal.expired, severity: WARN)&lt;br/&gt;  notifyDealStageChange(producer_company_id, type: deal_expired)&lt;br/&gt;  notifyDealStageChange(buyer_company_id, type: deal_expired)&lt;br/&gt;  (bilingual AR + EN messages)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="2070" y="145" width="510" height="330" as="geometry"/>
    </mxCell>

    <!-- ─── NOTIFICATION SYSTEM ─── -->
    <mxCell id="100" value="&lt;b&gt;NOTIFICATION SYSTEM&lt;/b&gt;" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;fontStyle=1;fontSize=10;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="2060" y="490" width="530" height="28" as="geometry"/>
    </mxCell>

    <mxCell id="101" value="&lt;b&gt;notify.ts — Event Triggers&lt;/b&gt;&lt;br/&gt;─────────────────────────────────────&lt;br/&gt;notifyOfferReceived(listingId) → producer&lt;br/&gt;notifyOutbid(listingId, offerId) → prev top buyer&lt;br/&gt;notifyOfferAccepted(offerId) → buyer&lt;br/&gt;notifyOfferRejected(offerId) → buyer&lt;br/&gt;notifyPrivateDealInvitation(listingId) → targeted buyer&lt;br/&gt;notifyDealStageChange(companyId, dealId, ...) → deal party&lt;br/&gt;─────────────────────────────────────&lt;br/&gt;Pattern: fire-and-forget via void operator&lt;br/&gt;Non-blocking — does not delay API response&lt;br/&gt;Always writes to notifications table&lt;br/&gt;Also triggers email.ts → Resend API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="2070" y="527" width="510" height="240" as="geometry"/>
    </mxCell>

    <mxCell id="102" value="&lt;b&gt;notifications&lt;/b&gt;&lt;br/&gt;────────────────&lt;br/&gt;id (uuid PK)&lt;br/&gt;company_id (FK)&lt;br/&gt;type (enum)&lt;br/&gt;title_ar, title_en&lt;br/&gt;body_ar, body_en&lt;br/&gt;is_read (boolean)&lt;br/&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="2070" y="778" width="240" height="175" as="geometry"/>
    </mxCell>

    <mxCell id="103" value="&lt;b&gt;email.ts → Resend API&lt;/b&gt;&lt;br/&gt;Bilingual HTML emails (AR + EN)&lt;br/&gt;Sent to company owner's email&lt;br/&gt;(looked up via company_members)&lt;br/&gt;Pattern: fire-and-forget" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
      <mxGeometry x="2325" y="778" width="255" height="175" as="geometry"/>
    </mxCell>

    <mxCell id="104" value="Notification API routes:&lt;br/&gt;GET /notifications (requireAuth + requireCompany)&lt;br/&gt;PATCH /notifications/:id/read&lt;br/&gt;POST /notifications/read-all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1">
