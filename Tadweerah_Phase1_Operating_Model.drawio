        </mxCell>
        <mxCell id="d3_closed" value="status = closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="730" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="d3_close1" value="① Producer manually&#xa;DELETE /listings/:id&#xa;(soft close, data preserved)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="150" y="750" width="190" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="d3_close2" value="② Offer Accepted&#xa;→ listing auto-closed&#xa;atomically with deal creation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="750" width="190" height="55" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="d3_ag1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d3_g1" target="d3_create" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d3_a1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d3_create" target="d3_open" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d3_a2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d3_open" target="d3_tgt" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d3_a3" value="open" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d3_tgt" target="d3_tgt_open" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d3_a4" value="category" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d3_tgt" target="d3_tgt_cat" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d3_a5" value="specific" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d3_tgt" target="d3_tgt_specific" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d3_a6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d3_tgt_cat" target="d3_lic_only" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d3_a7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d3_close1" target="d3_closed" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d3_a8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d3_close2" target="d3_closed" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ═══════════════════════════════════════════════════════════════
       PAGE 4 — OFFERS & BIDDING
       ═══════════════════════════════════════════════════════════════ -->
  <diagram name="4. Offers &amp; Bidding" id="d4">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="d4_title" value="C. Offers &amp; Bidding Flow" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="800" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="d4_desc" value="Buyers submit price offers on open listings. A rules engine checks eligibility. The producer selects one offer; the rest are auto-rejected and a deal is created atomically." style="text;html=1;fontSize=11;align=center;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="52" width="1000" height="20" as="geometry"/>
        </mxCell>

        <!-- Rules Engine box -->
        <mxCell id="d4_rules" value="Rules Engine — checkPureEligibility (POST /listings/:id/offers)" style="text;html=1;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="85" width="950" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="d4_r1" value="✅ listing.status = open" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="113" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d4_r2" value="✅ buyer ≠ producer (own listing)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="275" y="113" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d4_r3" value="✅ buyer.license_status = approved" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="113" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d4_r4" value="✅ buyer has CR number" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="705" y="113" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d4_r5" value="✅ No existing offer from buyer on same listing (unique constraint)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="320" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d4_r6" value="✅ Targeting match: open | category | specific_company" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="395" y="150" width="290" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d4_r7" value="✅ If LICENSED_ONLY: buyer capability + license match" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="150" width="270" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d4_rfail" value="Fail → 403 OwnListing | CompanyIncomplete | LicenseRequired | TargetingRestricted&#xa;409 OfferExists    422 CommercialRegistrationRequired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="187" width="860" height="36" as="geometry"/>
        </mxCell>

        <!-- Submit offer -->
        <mxCell id="d4_submit" value="POST /listings/:id/offers&#xa;{ price_per_unit }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="270" width="230" height="55" as="geometry"/>
        </mxCell>

        <!-- Offer status: pending -->
        <mxCell id="d4_pending" value="offer.status = pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="375" width="210" height="50" as="geometry"/>
        </mxCell>

        <!-- Buyer actions -->
        <mxCell id="d4_buyer_act" value="Buyer Actions (PUT /offers/mine)" style="text;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="440" width="260" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="d4_improve" value="Improve Offer&#xa;(increase price_per_unit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="466" width="170" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="d4_withdraw" value="offer.status = withdrawn&#xa;(terminal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="540" width="170" height="45" as="geometry"/>
        </mxCell>

        <!-- Producer accepts -->
        <mxCell id="d4_prod_act" value="Producer Action" style="text;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="440" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="d4_accept_btn" value="PUT /offers/:id/accept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="466" width="200" height="45" as="geometry"/>
        </mxCell>

        <!-- Outcomes -->
        <mxCell id="d4_accepted" value="offer.status = accepted ✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="570" width="220" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="d4_others_rejected" value="All other offers on same listing&#xa;→ status = rejected (atomic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="750" y="570" width="210" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="d4_listing_closed" value="listing.status = closed (atomic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="635" width="220" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="d4_deal_created" value="Deal Created&#xa;deal.status = active 🎯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="695" width="220" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="d4_rejected" value="offer.status = rejected&#xa;(terminal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="635" width="160" height="45" as="geometry"/>
        </mxCell>

        <!-- ANNOTATION: item 2 — Notification note after offer accepted / deal created -->
        <mxCell id="d4_notif_deal" value="📧 Accepted buyer notified | 📧 All rejected buyers notified | 📧 Producer receives deal summary" style="text;html=1;fontSize=10;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="500" y="758" width="500" height="28" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="d4_a1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d4_submit" target="d4_pending" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d4_a2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d4_pending" target="d4_improve" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d4_a3" value="Withdraw" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d4_improve" target="d4_withdraw" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d4_a4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d4_pending" target="d4_accept_btn" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d4_a5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d4_accept_btn" target="d4_accepted" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d4_a6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d4_accept_btn" target="d4_others_rejected" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d4_a7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d4_accepted" target="d4_listing_closed" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d4_a8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d4_listing_closed" target="d4_deal_created" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d4_a9" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d4_others_rejected" target="d4_rejected" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ═══════════════════════════════════════════════════════════════
       PAGE 5 — DEAL LIFECYCLE
       ═══════════════════════════════════════════════════════════════ -->
  <diagram name="5. Deal Lifecycle" id="d5">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="d5_title" value="D. Deal Lifecycle State Machine" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="800" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="d5_desc" value="A deal is created atomically when an offer is accepted. It progresses through payment, dispatch, and receipt. Automated SLA expiry jobs monitor each stage." style="text;html=1;fontSize=11;align=center;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="52" width="1000" height="20" as="geometry"/>
        </mxCell>

        <!-- START -->
        <mxCell id="d5_start" value="Deal Created&#xa;(Offer Accepted)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="130" height="55" as="geometry"/>
        </mxCell>

        <!-- ACTIVE -->
        <mxCell id="d5_active" value="active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="195" width="150" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="d5_active_note" value="SLA: 31 days&#xa;Buyer must pay" style="text;html=1;fontSize=10;align=center;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="230" y="265" width="150" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="d5_active_action" value="PUT /deals/:id/confirm-payment&#xa;Actor: Producer&#xa;Requires: payment_reference" style="text;html=1;fontSize=10;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="310" width="220" height="42" as="geometry"/>
        </mxCell>

        <!-- PAYMENT_CONFIRMED -->
        <mxCell id="d5_payment" value="payment_confirmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="195" width="185" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="d5_payment_note" value="SLA: 8 days&#xa;Transport decision here" style="text;html=1;fontSize=10;align=center;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="470" y="265" width="185" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="d5_payment_action" value="PUT /deals/:id/confirm-dispatch&#xa;Actor: Producer&#xa;Requires: actual_quantity (if by_weight)" style="text;html=1;fontSize=10;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="310" width="230" height="42" as="geometry"/>
        </mxCell>

        <!-- DISPATCHED -->
        <mxCell id="d5_dispatched" value="dispatched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="195" width="150" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="d5_dispatched_note" value="SLA: 72 hours&#xa;Goods in transit" style="text;html=1;fontSize=10;align=center;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="730" y="265" width="150" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="d5_dispatched_action" value="PUT /deals/:id/confirm-receipt&#xa;Actor: Buyer" style="text;html=1;fontSize=10;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="730" y="310" width="200" height="30" as="geometry"/>
        </mxCell>

        <!-- COMPLETED -->
        <mxCell id="d5_completed" value="completed ✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="195" width="160" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="d5_completed_note" value="Terminal — success&#xa;No further transitions" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="960" y="265" width="160" height="30" as="geometry"/>
        </mxCell>

        <!-- EXPIRED -->
        <mxCell id="d5_expired" value="expired ⏱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="440" width="185" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d5_expired_note" value="Terminal — SLA breach&#xa;Triggered by: expire-deals.ts (auto-job)" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="507" width="280" height="28" as="geometry"/>
        </mxCell>

        <!-- CANCELLED -->
        <mxCell id="d5_cancelled" value="cancelled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="440" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d5_cancelled_note" value="Terminal — manual cancellation&#xa;(admin or platform action)" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="700" y="507" width="210" height="28" as="geometry"/>
        </mxCell>

        <!-- SLA Table -->
        <mxCell id="d5_sla_title" value="SLA Expiry Rules (expire-deals.ts automated job)" style="text;html=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="570" width="750" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="d5_sla1" value="active → expired (31 days from creation)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="150" y="598" width="270" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d5_sla2" value="payment_confirmed → expired (8 days)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="435" y="598" width="240" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d5_sla3" value="dispatched → expired (72 hours)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="598" width="210" height="30" as="geometry"/>
        </mxCell>

        <!-- by_weight note -->
        <mxCell id="d5_byw" value="⚠ by_weight pricing: actual_quantity (weighbridge) is required at confirm-dispatch&#xa;    Final price = actual_quantity × price_per_unit (instead of estimated qty)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="150" y="645" width="750" height="40" as="geometry"/>
        </mxCell>

        <!-- ANNOTATIONS: item 2 — Notification notes -->
        <mxCell id="d5_notif_payment" value="📧 Buyer notified: payment confirmed, dispatch authorised" style="text;html=1;fontSize=10;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="470" y="362" width="290" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="d5_notif_dispatch" value="📧 Buyer notified: goods dispatched, 72h window starts" style="text;html=1;fontSize=10;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="730" y="348" width="270" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="d5_notif_complete" value="📧 Both parties notified: deal completed" style="text;html=1;fontSize=10;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="960" y="268" width="220" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="d5_notif_expired" value="📧 Both parties notified: deal expired" style="text;html=1;fontSize=10;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="450" y="507" width="220" height="26" as="geometry"/>
        </mxCell>

        <!-- ANNOTATIONS: item 3 — 4 policy note boxes -->
        <!-- Note 1: Extension rule -->
        <mxCell id="d5_note_ext" value="Extension Rule:&#xa;Producer may extend once (+7 calendar days). Triggered by notification sent 3 days before expiry.&#xa;No second extension permitted. After extension expires → deal auto-expires." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="700" width="430" height="58" as="geometry"/>
        </mxCell>

        <!-- Note 2: Cancellation rules -->
        <mxCell id="d5_note_cancel" value="Cancellation:&#xa;• Producer: can cancel before dispatch (active or payment_confirmed)&#xa;• Buyer: cannot cancel — issue report only&#xa;• Admin: can cancel at any state&#xa;• After dispatch: no cancellation permitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="530" y="700" width="370" height="72" as="geometry"/>
        </mxCell>

        <!-- Note 3: Admin force-complete -->
        <mxCell id="d5_note_admin" value="Admin force-complete available from: active, payment_confirmed, dispatched, expired&#xa;→ sets status = completed. Recorded in audit log with admin attribution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="775" width="430" height="44" as="geometry"/>
        </mxCell>

        <!-- Note 4: Issue reporting -->
        <mxCell id="d5_note_issue" value="Issue Reporting:&#xa;If a problem occurs after completion: either party submits POST /api/issue-reports.&#xa;Admin reviews and resolves offline. No automated dispute resolution in Phase 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="530" y="780" width="370" height="52" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="d5_a1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d5_start" target="d5_active" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d5_a2" value="confirm-payment" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d5_active" target="d5_payment" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d5_a3" value="confirm-dispatch" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d5_payment" target="d5_dispatched" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
