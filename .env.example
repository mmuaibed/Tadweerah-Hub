# =============================================================================
# Tadweerah — Environment Variables Reference
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required — server will not start without it)
DATABASE_URL=postgresql://user:password@host:5432/tadweerah

# ── Server ────────────────────────────────────────────────────────────────────
# Port the API server listens on (assigned by hosting platform)
PORT=8080

# Node environment: development | production
NODE_ENV=development

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ── Frontend ──────────────────────────────────────────────────────────────────
# Base path for the frontend (e.g. "/" for root deployment)
BASE_PATH=/

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Server-side secret key (required — never expose to client)
CLERK_SECRET_KEY=sk_live_...

# Client-side publishable key (required — safe to expose to browser)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudGFkd2VlcmFoLmNvbSQy

# Clerk Frontend API proxy URL (production only — enables custom domain auth)
# Set to: https://yourdomain.com/api/__clerk
VITE_CLERK_PROXY_URL=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Resend API key — without this, all emails are silently skipped
RESEND_API_KEY=re_...

# Sender address shown in outgoing emails
EMAIL_FROM=تدويرة <noreply@tadweerah.sa>

# Ops team email that receives transport request notifications
TRANSPORT_REQUEST_EMAIL=info@tadweerah.com

# Support team email for issue report notifications
SUPPORT_EMAIL=support@tadweerah.com

# ── Platform ──────────────────────────────────────────────────────────────────
# Public URL of the platform — used in email links and PDF headers
PLATFORM_URL=https://tadweerah.sa

# ── Security ──────────────────────────────────────────────────────────────────
# Secret key for session signing
SESSION_SECRET=change-me-to-a-long-random-string

# API key required to access /api/admin/* endpoints
# Without this, admin endpoints are unprotected — always set in production
ADMIN_API_KEY=change-me-to-a-secure-random-key
